# Copy this file to config.env and fill in your own values.
# config.env is git-ignored. Never commit real credentials.

NODE_ENV=development
PORT=4000

# MongoDB Atlas, e.g. mongodb+srv://<user>:<PASSWORD>@cluster0.xxxxx.mongodb.net/xero
DATABASE=
DATABASE_PASSWORD=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Payments (Stripe test-mode secret key)
STRIPE_SECRET_KEY=

# Email: SMTP for development (e.g. Mailtrap), Mailgun for production
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
MAILGUN_API=
MAILGUN_DOMAIN=
MAILGUN_MAIL=

# Newsletter
MAILCHIMP_URL=
